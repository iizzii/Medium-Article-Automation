      "mermaid_code": "",
      "chart_spec": null,
      "code_snippet": "def wilson_lower_bound(tp: int, total: int, z: float = 1.96) -> float:\n    if total == 0:\n        return 0.0\n    p_hat = tp / total\n    denom = 1.0 + (z * z) / total\n    center = p_hat + (z * z) / (2.0 * total)\n    margin = z * math.sqrt((p_hat * (1.0 - p_hat) + (z * z) / (4.0 * total)) / total)\n    return (center - margin) / denom",
